<Window x:Class="DecanatPROFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DecanatPRO"
        Height="450"
        Width="800">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <Label Content="Имя"/>
            <TextBox Text="{Binding CurrentStudent.Name,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Группа" Margin="0,10,0,0"/>
            <TextBox Text="{Binding CurrentStudent.Group,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Специальность" Margin="0,10,0,0"/>
            <TextBox Text="{Binding CurrentStudent.Speciality,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Добавить"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding AddStudentCommand}"/>

                <Button Content="Удалить"
                        Width="100"
                        Command="{Binding RemoveStudentCommand}"/>
            </StackPanel>

        </StackPanel>

        <ListView Grid.Column="1"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding Students}"
                  SelectedItem="{Binding CurrentStudent, Mode=TwoWay}">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Имя"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="150"/>

                    <GridViewColumn Header="Группа"
                                    DisplayMemberBinding="{Binding Group}"
                                    Width="100"/>

                    <GridViewColumn Header="Специальность"
                                    DisplayMemberBinding="{Binding Speciality}"
                                    Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
